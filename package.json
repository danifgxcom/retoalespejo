{
  "name": "reto-al-espejo-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm run test",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "backend:test": "cd backend && npm run test",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "shared:build": "npm run build --workspace @reto/geometry",
    "build": "npm run shared:build && npm run frontend:build && npm run backend:build",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:typecheck": "npm run typecheck --workspace frontend",
    "frontend:lint": "npm run lint --workspace frontend",
    "typecheck": "npm run frontend:typecheck",
    "lint": "npm run frontend:lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
